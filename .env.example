# SPORTZ_AI Environment Configuration Example

# Frontend Configuration (Vite)
# Leave blank for local development (Vite proxies /api to port 8787).
# Set to your deployed API host if hosting frontend and backend on separate domains.
# VITE_API_BASE_URL=https://api.sportz-ai.example.com

# Backend Configuration (Node.js API)
API_PORT=8787
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Local AI Development (Ollama)
# Enables local Ollama preset during development. Automatically blocked in production.
AI_ALLOW_LOCAL_ENDPOINTS=false
